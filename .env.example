# Optional contact form. Leave ALL blank until the owner has configured services.
# These are SERVER variables, not NEXT_PUBLIC_*. The site key alone is public
# and is passed only to /contact. Never commit real keys or recipient details.
CONTACT_FORMSPREE_FORM_ID=
CONTACT_TURNSTILE_SITE_KEY=
# Set true ONLY after enabling Turnstile CAPTCHA in the Formspree dashboard.
# Its secret key belongs in Formspree's private CAPTCHA settings, NEVER here
# as a NEXT_PUBLIC variable or in a client component.
CONTACT_FORMSPREE_TURNSTILE_ENABLED=
